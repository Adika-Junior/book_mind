# Copy to .env for single-process / local use. Real environment variables always win.
# Every *_PASSWORD / *_TOKEN / *_URL secret can instead be given as NAME_FILE=/path/to/file.

# Local model (Research / Simplify). Must be pulled first: ollama pull llama3.2
BOOKMIND_OLLAMA_MODEL=llama3.2
BOOKMIND_OLLAMA_URL=http://localhost:11434/api/chat
BOOKMIND_OLLAMA_TIMEOUT_S=120
BOOKMIND_MAX_CONCURRENT_GENERATIONS=2

# --- Only needed once other people/devices can reach it ---
# Setting a password turns on HTTP Basic Auth for everything (API and app).
BOOKMIND_AUTH_USER=bookmind
BOOKMIND_AUTH_PASSWORD=
# Required by internal services when set (defence in depth under mTLS/NetworkPolicy).
BOOKMIND_INTERNAL_TOKEN=
# Shared state across replicas (rate limits, idempotency, cache, event streams). Blank = in-memory.
BOOKMIND_REDIS_URL=
BOOKMIND_ALLOWED_ORIGINS=
# Trust X-Real-IP only when a proxy you control (deploy/nginx) sets it.
BOOKMIND_TRUST_PROXY=false

# Abuse guards
BOOKMIND_MAX_SELECTION_CHARS=2000
BOOKMIND_MAX_CONTEXT_CHARS=6000
BOOKMIND_RATE_API_PER_S=20
BOOKMIND_RATE_API_BURST=60
BOOKMIND_RATE_RESEARCH_PER_MIN=10
BOOKMIND_RATE_RESEARCH_BURST=5

# Distributed tracing export (Jaeger / Tempo / any OTLP collector). Blank = off.
OTEL_EXPORTER_OTLP_ENDPOINT=
