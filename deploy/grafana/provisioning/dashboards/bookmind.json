{
 "uid": "bookmind",
 "title": "BookMind \u2014 service overview",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "type": "timeseries",
   "title": "Requests / s by service",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (service) (rate(bookmind_http_requests_total[5m]))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Gateway error ratio (SLO 0.5%)",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "bookmind:api_errors:ratio_rate5m",
     "legendFormat": "5m",
     "refId": "A"
    },
    {
     "expr": "bookmind:api_errors:ratio_rate1h",
     "legendFormat": "1h",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "p95 latency by service",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(bookmind_http_request_duration_seconds_bucket[5m])))",
     "legendFormat": "{{service}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Research answers by source",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (source) (rate(bookmind_research_generations_total[15m]))",
     "legendFormat": "{{source}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Circuit breakers (2 = open)",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "max by (service, breaker) (bookmind_circuit_breaker_state)",
     "legendFormat": "{{service}} \u2192 {{breaker}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Events",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (topic, outcome) (rate(bookmind_events_consumed_total[5m]))",
     "legendFormat": "{{topic}} {{outcome}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Cache outcomes",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (cache, outcome) (rate(bookmind_cache_requests_total[5m]))",
     "legendFormat": "{{cache}} {{outcome}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Rate limited / idempotent replays",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (scope) (rate(bookmind_rate_limited_total[5m]))",
     "legendFormat": "429 {{scope}}",
     "refId": "A"
    },
    {
     "expr": "rate(bookmind_idempotent_replays_total[5m])",
     "legendFormat": "replays",
     "refId": "B"
    }
   ]
  }
 ],
 "tags": [
  "bookmind"
 ]
}